{
    "GLOBAL_HOTKEY": "Ctrl+Space",
    "SAMPLE_RATE": 16000,
    "SETTINGS_PORT": 8765,
    "MODELS_DIR": "/media/manoj/F1/models-handy",
    "ACTIVE_ASR_PRESET": "instant_english",
    "ACTIVE_REFINEMENT_GOAL": "official_english",
    "WHISPER_FALLBACK_MODEL": "large-v3-turbo",
    "OLLAMA_MODELS": {
        "en": "qwen2.5:3b",
        "hi": "SL-Lexicons/llama3-hindi-8b-q5_km.gguf:latest"
    },
    "OLLAMA_TRANSLATE_MODELS": {
        "to_en": "qwen2.5:3b",
        "to_hi": "SL-Lexicons/llama3-hindi-8b-q5_km.gguf:latest"
    },
    "OLLAMA_HOST": "http://localhost:11434",
    "OLLAMA_KEEP_ALIVE": "60m",
    "SILENCE_THRESHOLD": 250,
    "SILENCE_DURATION": 4,
    "PRE_ROLL_BUFFER_MS": 500,
    "VAD_THRESHOLD": 0.5,
    "TEMPERATURE": 0,
    "DIRECT_TYPING": true,
    "SAVE_TO_MARKDOWN": false,
    "MARKDOWN_PATH": "~/Documents/VoiceNotes",
    "TYPING_TOOL": "auto",
    "PASTE_METHOD": "clipboard_restore",
    "PASTE_DELAY_MS": 150,
    "PASTE_KEY_COMBO": "shift_insert",
    "OVERLAY_POSITION": "top",
    "OVERLAY_STYLE": "wave",
    "SHORTCUT_ACTIVATION": "hold_or_toggle",
    "HOLD_THRESHOLD_MS": 300,
    "RELEASE_GRACE_MS": 50,
    "PAUSE_GUIDED_CHUNKING": true,
    "CHUNK_TARGET_SECONDS": 30,
    "CHUNK_MAX_SECONDS": 40,
    "CHUNK_MIN_SECONDS": 8.0,
    "CHUNK_MIN_PAUSE_MS": 250,
    "ENABLE_FILLER_REMOVAL": true,
    "COLLAPSE_STUTTERS": true,
    "CUSTOM_FILLER_WORDS": [],
    "ENABLE_FUZZY_CUSTOM_WORDS": true,
    "FUZZY_MATCH_THRESHOLD": 0.35,
    "CUSTOM_WORDS": [
        "ChatGPT",
        "OpenAI",
        "Claude",
        "MacBook Pro",
        "ChargeBee",
        "GitHub",
        "DevOps"
    ],
    "CLI_RICH_HUD": true,
    "FEATURES": {
        "start_end_sounds": true,
        "clipboard_output": true,
        "markdown_output": true,
        "direct_typing": true,
        "evening_review": true,
        "pwd_terminology_corrector": true,
        "filler_word_removal": true,
        "fuzzy_custom_words": true,
        "terminal_rich_hud": true
    },
    "ASR_PRESETS": {
        "smart_bilingual": {
            "label": "🎯 Smart Bilingual (Whisper Turbo)",
            "backend": "faster_whisper",
            "model": "large-v3-turbo",
            "device": "auto",
            "asr_language": null,
            "description": "Auto-detects English, Hindi, and mixed Hinglish. Preserves English acronyms in Latin script."
        },
        "instant_english": {
            "label": "⚡ Instant Pure English (Nemotron)",
            "backend": "transcribe_cpp",
            "model": "nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf",
            "device": "auto",
            "asr_language": "en",
            "description": "Ultra-fast (<0.8s). Strictly for English speech. Do not use for Hindi audio."
        },
        "instant_hindi": {
            "label": "⚡ Instant Pure Hindi (Nemotron)",
            "backend": "transcribe_cpp",
            "model": "nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf",
            "device": "auto",
            "asr_language": "hi",
            "description": "Ultra-fast (<0.8s). Strictly for pure Devanagari Hindi speech. Do not use for English audio."
        },
        "roman_hinglish": {
            "label": "💬 Roman Hinglish Notes (Apex)",
            "backend": "transcribe_cpp",
            "model": "Whisper-Hindi2Hinglish-Apex-Q8.bin",
            "device": "auto",
            "asr_language": null,
            "description": "Fast (<0.7s). Transcribes Hindi/Hinglish speech into Roman Latin script (WhatsApp/Slack style)."
        }
    },
    "REFINEMENT_GOALS": {
        "clean_bilingual": {
            "label": "🌐 Bilingual Field Note",
            "output_lang": "bilingual",
            "target_lang": "bilingual",
            "format": "clean_paragraph",
            "intent": "clean_paragraph",
            "acronyms": "preserve_latin",
            "translate": false,
            "action": "refine_only",
            "description": "Polishes grammar, capitalizes PWD acronyms (EE, JE, MB, NIT), preserves spoken mix."
        },
        "official_english": {
            "label": "🇬🇧 Official English Memo",
            "output_lang": "pure_english",
            "target_lang": "pure_english",
            "format": "clean_paragraph",
            "intent": "clean_paragraph",
            "acronyms": "preserve_latin",
            "translate": true,
            "action": "translate_and_refine",
            "description": "Polishes into formal civil engineering English; translates Hindi phrases."
        },
        "official_hindi": {
            "label": "🇮🇳 Official Hindi Directive",
            "output_lang": "pure_hindi",
            "target_lang": "pure_hindi",
            "format": "clean_paragraph",
            "intent": "clean_paragraph",
            "acronyms": "preserve_latin",
            "translate": true,
            "action": "translate_and_refine",
            "description": "Polishes into formal administrative Devanagari Hindi."
        },
        "concise_summary": {
            "label": "📋 Concise Executive Summary",
            "output_lang": "auto",
            "target_lang": "same_as_input",
            "format": "concise_summary",
            "intent": "concise_summary",
            "acronyms": "preserve_latin",
            "translate": false,
            "action": "refine_only",
            "description": "Executive bullet summary with key decisions, dates, and sanctions."
        },
        "ideas_actions": {
            "label": "💡 Ideas, Tasks & Action Items",
            "output_lang": "auto",
            "target_lang": "same_as_input",
            "format": "ideas_actions",
            "intent": "ideas_actions",
            "acronyms": "preserve_latin",
            "translate": false,
            "action": "refine_only",
            "description": "Actionable task breakdown with responsible roles, deadlines, and blockers."
        },
        "roman_hinglish": {
            "label": "💬 Casual Roman Text",
            "output_lang": "roman_hinglish",
            "target_lang": "roman_hinglish",
            "format": "clean_paragraph",
            "intent": "clean_paragraph",
            "acronyms": "preserve_latin",
            "translate": false,
            "action": "refine_only",
            "description": "Conversational code-mix written entirely in English alphabet."
        }
    },
    "WHISPER_MODEL": "large-v3-turbo",
    "ASR_ENGINE": "transcribe_cpp",
    "ACTIVE_MODEL_PROFILE": "instant_english",
    "LANGUAGE_MODE": "pure_english",
    "MODE": "translate",
    "CACHE_RETENTION_DAYS": 7,
    "TTS_ENGINE": "kokoro",
    "KOKORO_MODEL_DIR": "/media/manoj/F1/mkbmodel/kokoro-models",
    "KOKORO_VOICE_EN": "en_in_female",
    "KOKORO_VOICE_HI": "hf_alpha"
}