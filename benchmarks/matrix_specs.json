{
  "benchmark_version": "1.0.0",
  "description": "Multi-mode PWD Speech Refinement Evaluation Matrix",
  "recordings_dir": "benchmarks/recordings",
  "scripts_dir": "benchmarks/scripts",
  "scripts": [
    {
      "id": "script1",
      "title": "System & Technical Manual Governance",
      "category": "pure_english",
      "script_file": "script1.txt",
      "audio_files": ["script1.wav", "script1.mp3", "script1.m4a", "script1.ogg"],
      "expected_class": "pure_english",
      "mandatory_terms": ["system", "manual", "documentation"],
      "forbidden_tokens": ["(IAR)", "(REC)", "(SUS)", "(MD)", "(DS)", "(EE)", "(MB)"],
      "rules": {
        "bilingual": {
          "expected_lang": "en",
          "allow_devanagari": false,
          "allow_chinese": false,
          "justification": "In bilingual mode, pure English must stay 100% English. Zero Hindi translation."
        },
        "pure_english": {
          "expected_lang": "en",
          "allow_devanagari": false,
          "justification": "Pure English mode must output polished English."
        },
        "pure_hindi": {
          "expected_lang": "hi",
          "allow_devanagari": true,
          "justification": "Pure Hindi mode should formulate Hindi with technical terms in English."
        },
        "translate": {
          "expected_lang": "hi",
          "allow_devanagari": true,
          "justification": "Translate mode must translate English into professional Hindi."
        }
      }
    },
    {
